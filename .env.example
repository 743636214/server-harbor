PORT=4317
BRIDGE_PORT=4320
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=server_harbor
MYSQL_DATABASE=server_harbor
# npm run setup creates a Keychain entry. Never put passwords or VAULT_KEY in this file.
HARBOR_KEYCHAIN_ACCOUNT=
# Set after the localhost database account is provisioned.
# MYSQL_SOCKET_PATH=/tmp/mysql.sock
NODE_ENV=development
HOST=127.0.0.1
PUBLIC_URL=http://127.0.0.1:4317
SSH_BIND_HOST=127.0.0.1
SSH_PUBLIC_HOST=127.0.0.1
SSH_PUBLIC_PORT=4320
RECORD_SESSIONS=true
RECORDING_MAX_BYTES=33554432
# Linux production: executable reads each named secret from an external secret manager.
# HARBOR_SECRET_PROVIDER=/run/harbor-secrets/read-secret
# Remote MySQL must use verified TLS (Unix socket is preferred).
# MYSQL_TLS=true
# MYSQL_SSL_CA_FILE=/path/to/ca.pem
